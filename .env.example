# Source GitLab Instance
SOURCE_GITLAB_URL=https://old-gitlab.example.com
SOURCE_GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Destination GitLab Instance
DEST_GITLAB_URL=https://new-gitlab.example.com
DEST_GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Source: set EXACTLY ONE of the two variables below

# Source group path (can include subgroups: group/subgroup)
SOURCE_GROUP_PATH=mon-groupe-source

# OR source username: migrates the personal projects (not in a group) of this user
# SOURCE_USER=jdupont

# Destination group path (can include subgroups: group/subgroup)
# OR a username to migrate into a personal namespace (no subgroups in that case)
# The hierarchy from source will be recreated under this path
DEST_GROUP_PATH=mon-groupe-destination
